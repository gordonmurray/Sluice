{"version": 2, "width": 100, "height": 30, "timestamp": 1788868052, "env": {"TERM": "xterm-256color"}, "title": "Sluice: a paid HTTP request, end to end"}
[0.051626, "o", "\u001b[2J\u001b[H\u001b[1;36mSLUICE  |  HTTP requests with x402 payments\u001b[0m\r\nLocal Anvil chain / mock USDC / fake funds\r\n\r\n\u001b[1;33m1 / 4   A free health check\u001b[0m\r\n\r\n"]
[2.051771, "o", "GET /healthz\r\n"]
[2.069825, "o", "HTTP 200\r\nok\r\n\r\nThe gateway is running. No payment is required.\r\n"]
[9.070307, "o", "\u001b[2J\u001b[H\u001b[1;36mSLUICE  |  HTTP requests with x402 payments\u001b[0m\r\nLocal Anvil chain / mock USDC / fake funds\r\n\r\n\u001b[1;33m2 / 4   Ask for a search without paying\u001b[0m\r\n\r\n"]
[11.070487, "o", "POST /firn/ns/demo/query\r\n"]
[11.083742, "o", "HTTP 402 Payment Required\r\n\r\nDecoded payment-required header:\r\n{\r\n  \"scheme\": \"exact\",\r\n  \"network\": \"eip155:8453\",\r\n  \"amount\": \"50000\",\r\n  \"asset\": \"0x057ef64E23666F000b34aE31332854aCBd1c8544\",\r\n  \"payTo\": \"0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC\"\r\n}\r\n\r\n50,000 micro-USDC = 0.05 USDC in token units. Local fake value."]
[11.08376, "o", "\r\n"]
[21.084042, "o", "\u001b[2J\u001b[H\u001b[1;36mSLUICE  |  HTTP requests with x402 payments\u001b[0m\r\nLocal Anvil chain / mock USDC / fake funds\r\n\r\n\u001b[1;33m3 / 4   Sign, settle, and retry\u001b[0m\r\n\r\n"]
[23.084423, "o", "$ ./scripts/pay-with-curl.sh\r\n\r\nRequesting a quote and signing with the public local demo key.\r\nWaiting for local settlement...\r\n"]
[30.580467, "o", "\r\nHTTP 200 OK\r\n\r\nFirst search result:\r\n{\r\n  \"id\": 1,\r\n  \"score\": 0.25,\r\n  \"text\": \"x402 is an open protocol for HTTP-native payments: a server answers 402 Payment Required with machine-readable requirements and the client retries with a signed payment.\"\r\n}\r\n\r\nPayment settled before the origin handled the request.\r\n"]
[39.581088, "o", "\u001b[2J\u001b[H\u001b[1;36mSLUICE  |  HTTP requests with x402 payments\u001b[0m\r\nLocal Anvil chain / mock USDC / fake funds\r\n\r\n\u001b[1;33m4 / 4   Check the payment and indexed receipt\u001b[0m\r\n\r\n"]
[41.801913, "o", "Decoded payment-response header:\r\n"]
[41.802023, "o", "{\r\n  \"network\": \"eip155:8453\",\r\n  \"payer\": \"0xa7490FFD6fFAF9C629a1E1Be4875E6b7700943DA\",\r\n  \"success\": true,\r\n  \"transaction\": \"0x906005c3c58911d07dbbba146a6402506722a0968bb1e47d5c037e2e50157a37\"\r\n}\r\n\r\nChain transaction: successful\r\nReceiver balance: +50,000 micro-USDC\r\nPostgres receipt: amount=50000, origin_status=200\r\n\r\n402 -> signed payment -> settlement -> search result -> indexed receipt\r\n\r\nRun the full check: ./scripts/smoke.sh\r\n"]
